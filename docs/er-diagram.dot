digraph er {
graph [rankdir=LR, bgcolor="white", pad=0.25, nodesep=1.0, ranksep=1.0, splines=spline, fontname="DejaVu Sans"];
node [shape=plain, fontname="DejaVu Sans"];
edge [color="#64748b", penwidth=1.3, arrowsize=0.7, fontname="DejaVu Sans", fontsize=10];
users [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#1e3a5f"><FONT COLOR="white"><B>users</B><BR/>Пользователи</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="login_l">PK </TD><TD ALIGN="LEFT">login</TD><TD ALIGN="LEFT" PORT="login_r">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" PORT="display_login_l"></TD><TD ALIGN="LEFT">display_login</TD><TD ALIGN="LEFT" PORT="display_login_r">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" PORT="name_l"></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT" PORT="name_r">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT" PORT="city_l"></TD><TD ALIGN="LEFT">city</TD><TD ALIGN="LEFT" PORT="city_r">VARCHAR(80)</TD></TR><TR><TD ALIGN="LEFT" PORT="contact_l"></TD><TD ALIGN="LEFT">contact</TD><TD ALIGN="LEFT" PORT="contact_r">VARCHAR(100)</TD></TR><TR><TD ALIGN="LEFT" PORT="password_hash_l"></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT" PORT="password_hash_r">BYTEA</TD></TR><TR><TD ALIGN="LEFT" PORT="salt_l"></TD><TD ALIGN="LEFT">salt</TD><TD ALIGN="LEFT" PORT="salt_r">BYTEA</TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10">PK: нормализованный login</FONT></TD></TR></TABLE>>];
books [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#1e3a5f"><FONT COLOR="white"><B>books</B><BR/>Книги</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_l">PK </TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT" PORT="id_r">INTEGER</TD></TR><TR><TD ALIGN="LEFT" PORT="owner_login_l">FK</TD><TD ALIGN="LEFT">owner_login</TD><TD ALIGN="LEFT" PORT="owner_login_r">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" PORT="title_l"></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT" PORT="title_r">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT" PORT="author_l"></TD><TD ALIGN="LEFT">author</TD><TD ALIGN="LEFT" PORT="author_r">VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT" PORT="genre_l"></TD><TD ALIGN="LEFT">genre</TD><TD ALIGN="LEFT" PORT="genre_r">VARCHAR(50)</TD></TR><TR><TD ALIGN="LEFT" PORT="condition_l"></TD><TD ALIGN="LEFT">condition</TD><TD ALIGN="LEFT" PORT="condition_r">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" PORT="description_l"></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT" PORT="description_r">VARCHAR(1000)</TD></TR><TR><TD ALIGN="LEFT" PORT="status_l"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT" PORT="status_r">VARCHAR(32)</TD></TR><TR><TD ALIGN="LEFT" PORT="deleted_l"></TD><TD ALIGN="LEFT">deleted</TD><TD ALIGN="LEFT" PORT="deleted_r">BOOLEAN</TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10">FK: RESTRICT; CHECK статуса и полей</FONT></TD></TR></TABLE>>];
exchanges [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#1e3a5f"><FONT COLOR="white"><B>exchanges</B><BR/>Заявки</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_l">PK </TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT" PORT="id_r">INTEGER</TD></TR><TR><TD ALIGN="LEFT" PORT="requested_id_l">FK</TD><TD ALIGN="LEFT">requested_id</TD><TD ALIGN="LEFT" PORT="requested_id_r">INTEGER</TD></TR><TR><TD ALIGN="LEFT" PORT="offered_id_l">FK</TD><TD ALIGN="LEFT">offered_id</TD><TD ALIGN="LEFT" PORT="offered_id_r">INTEGER</TD></TR><TR><TD ALIGN="LEFT" PORT="sender_login_l">FK</TD><TD ALIGN="LEFT">sender_login</TD><TD ALIGN="LEFT" PORT="sender_login_r">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" PORT="recipient_login_l">FK</TD><TD ALIGN="LEFT">recipient_login</TD><TD ALIGN="LEFT" PORT="recipient_login_r">VARCHAR(30)</TD></TR><TR><TD ALIGN="LEFT" PORT="pair_low_l"></TD><TD ALIGN="LEFT">pair_low</TD><TD ALIGN="LEFT" PORT="pair_low_r">INTEGER</TD></TR><TR><TD ALIGN="LEFT" PORT="pair_high_l"></TD><TD ALIGN="LEFT">pair_high</TD><TD ALIGN="LEFT" PORT="pair_high_r">INTEGER</TD></TR><TR><TD ALIGN="LEFT" PORT="created_at_l"></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT" PORT="created_at_r">TIMESTAMPTZ</TD></TR><TR><TD ALIGN="LEFT" PORT="status_l"></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT" PORT="status_r">VARCHAR(32)</TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10">FK: RESTRICT; UNIQUE активной пары; CHECK</FONT></TD></TR></TABLE>>];
exchange_confirmations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD COLSPAN="3" BGCOLOR="#1e3a5f"><FONT COLOR="white"><B>exchange_confirmations</B><BR/>Подтверждения</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="exchange_id_l">PK FK</TD><TD ALIGN="LEFT">exchange_id</TD><TD ALIGN="LEFT" PORT="exchange_id_r">INTEGER</TD></TR><TR><TD ALIGN="LEFT" PORT="user_login_l">PK FK</TD><TD ALIGN="LEFT">user_login</TD><TD ALIGN="LEFT" PORT="user_login_r">VARCHAR(30)</TD></TR><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT POINT-SIZE="10">PK: (exchange_id, user_login); FK: CASCADE</FONT></TD></TR></TABLE>>];
users:login_r:e -> books:owner_login_l:w [headlabel="1:N", labeldistance=1.6];
books:id_r:e -> exchanges:requested_id_l:w [headlabel="1:N", labeldistance=1.6];
books:id_r:e -> exchanges:offered_id_l:w [headlabel="1:N", labeldistance=1.6];
users:login_r:e -> exchanges:sender_login_l:w [headlabel="1:N", labeldistance=1.6];
users:login_r:e -> exchanges:recipient_login_l:w [headlabel="1:N", labeldistance=1.6];
exchanges:id_r:e -> exchange_confirmations:exchange_id_l:w [headlabel="1:N", labeldistance=1.6];
users:login_r:e -> exchange_confirmations:user_login_l:w [headlabel="1:N", labeldistance=1.6];
}